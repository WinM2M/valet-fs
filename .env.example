# ValetFS daemon configuration template.
# Copy to .env and adjust as needed. Loaded automatically at startup.

# Local mount point for the in-memory VFS.
VALETFS_MOUNT=/home/you/.valetfs/mnt

# Dev-mode HTTP control API bind address.
VALETFS_DEV_ADDR=127.0.0.1:8080

# Cloudflare Worker signaling endpoint (production mode only).
VALETFS_SIGNALING=https://valetfs-signaling.example.workers.dev

# Ephemeral diff repository directory (manifest hashes only - no plaintext).
VALETFS_GIT_DIR=/home/you/.valetfs/git
